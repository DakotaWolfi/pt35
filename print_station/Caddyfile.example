# FMI Print Station HYBRID example
# Configure an actual DNS name and a publicly trusted TLS certificate.
# Guests may print via HTTP on the Pi's port 8767 if HTTPS is unavailable.
# Admin APIs NEVER run on 8767. This HTTPS site proxies to 127.0.0.1:8768.
# Ensure Caddy's connection to the backend stays on this same device.
#
# When externally accessible, consider restricting who can reach admin APIs
# beyond the admin token (e.g. VPN / separate admin hostname / IP allowlist).
# Browser-facing receipts are best submitted via HTTPS; HTTP is a fallback only.
print.example.com {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy 127.0.0.1:8768 {
        header_up X-Forwarded-Proto https
    }
}
